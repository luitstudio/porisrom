// Canonical Prisma schema for Porisrom.
// Owned exclusively by @porisrom/backend — no other app should import this client directly.
//
// Dev: local Postgres via Docker Compose (DATABASE_URL points at localhost).
// Prod: same Postgres, running on the VPS (DATABASE_URL swapped, `prisma migrate deploy`).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  freelancer
  client
  admin
}

enum AccountStatus {
  active
  blocked
  deleted
}

enum ExternalIdentityProvider {
  google
}

model User {
  id                  String        @id @default(cuid())
  name                String
  email               String        @unique
  passwordHash        String
  role                Role?
  status              AccountStatus @default(active)
  termsAcceptedAt     DateTime?
  termsVersion        String?
  privacyPolicyAcceptedAt DateTime?
  privacyPolicyVersion    String?
  isOnboarded         Boolean       @default(false)
  profileCompleteness Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  freelancerProfile FreelancerProfile?
  companyProfile    CompanyProfile?

  authSessions        AuthSession[]
  externalIdentities ExternalIdentity[]
  googleLinkIntents  GoogleLinkIntent[]

  connectionsSent     Connection[] @relation("ConnectionRequester")
  connectionsReceived Connection[] @relation("ConnectionReceiver")
  messages            Message[]
  reviewsAuthored     Review[]
  paymentClaims       PaymentClaim[]
  blocksSent          UserBlock[] @relation("SafetyBlocker")
  blocksReceived      UserBlock[] @relation("SafetyBlocked")
  safetyCasesCreated  SafetyCase[] @relation("SafetyReporter")
  safetyCasesTargeted SafetyCase[] @relation("SafetyTarget")
  safetyCaseEvents    SafetyCaseEvent[]
  notificationReadStates NotificationReadState[]
}

model ExternalIdentity {
  id              String                   @id @default(cuid())
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        ExternalIdentityProvider
  providerSubject String
  emailAtLink     String
  emailVerifiedAt DateTime
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([provider, providerSubject])
  @@index([userId])
}

model GoogleLinkIntent {
  nonce     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, sessionId])
  @@index([expiresAt])
}

model AuthSession {
  id              String    @id
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String
  expiresAt       DateTime
  revokedAt       DateTime?
  reuseDetectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

enum VerificationStatus {
  pending
  approved
  rejected
}

// This is a manual document-review state. It is deliberately separate from
// public profile verification and does not represent Aadhaar authentication.
enum IdentityDocumentReviewStatus {
  pending
  approved
  rejected
}

model FreelancerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  bio                String?
  profilePhotoUrl    String?
  address            String?
  state              String?
  district           String?
  languages          String[]           @default([])
  experienceLevel    String?
  verificationStatus VerificationStatus @default(pending)
  isBadgeVerified    Boolean            @default(false)
  ratingAvg          Float              @default(0)
  ratingCount        Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  categories     FreelancerCategory[]
  skills         FreelancerSkill[]
  portfolioItems PortfolioItem[]
  identityDocument IdentityDocument?
}

model IdentityDocument {
  id                  String                       @id @default(cuid())
  freelancerProfileId String                       @unique
  freelancerProfile   FreelancerProfile            @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  status              IdentityDocumentReviewStatus @default(pending)
  cloudinaryPublicId  String
  cloudinaryAssetId   String
  reviewedAt          DateTime?
  reviewedBy          String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
}

model CompanyProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  companyName        String
  logoUrl            String?
  about              String?
  address            String?
  state              String?
  verificationStatus VerificationStatus @default(pending)
  isBadgeVerified    Boolean            @default(false)
  ratingAvg          Float              @default(0)
  ratingCount        Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  categories CompanyCategory[]
  documents  CompanyDocument[]
}

enum CompanyDocumentType {
  company_certificate
  aadhaar
}

enum CompanyDocumentUploadStatus {
  uploaded
}

model CompanyDocument {
  id               String                      @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile              @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  type             CompanyDocumentType
  uploadStatus     CompanyDocumentUploadStatus @default(uploaded)
  storagePublicId  String
  storageAssetId   String
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([companyProfileId])
  @@index([type])
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  freelancers FreelancerCategory[]
  companies   CompanyCategory[]
  skills      Skill[]
}

model Skill {
  id         String    @id @default(cuid())
  name       String    @unique
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  freelancers FreelancerSkill[]
}

model FreelancerCategory {
  freelancerProfileId String
  categoryId          String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id])
  category            Category          @relation(fields: [categoryId], references: [id])

  @@id([freelancerProfileId, categoryId])
}

model FreelancerSkill {
  freelancerProfileId String
  skillId             String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id])
  skill               Skill             @relation(fields: [skillId], references: [id])

  @@id([freelancerProfileId, skillId])
}

model CompanyCategory {
  companyProfileId String
  categoryId        String
  companyProfile    CompanyProfile @relation(fields: [companyProfileId], references: [id])
  category          Category       @relation(fields: [categoryId], references: [id])

  @@id([companyProfileId, categoryId])
}

enum PortfolioItemType {
  image
  video
  link
  document
}

model PortfolioItem {
  id                  String            @id @default(cuid())
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id])
  title               String
  description         String?
  type                PortfolioItemType
  url                 String
  createdAt           DateTime          @default(now())
}

model AdminActionLog {
  id           String   @id @default(cuid())
  adminId      String
  targetUserId String?
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())
}

enum ConnectionStatus {
  pending
  accepted
  declined
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id])
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id])
  status      ConnectionStatus @default(pending)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  conversation Conversation?

  @@unique([requesterId, receiverId])
}

model Conversation {
  id           String     @id @default(cuid())
  connectionId String     @unique
  connection   Connection @relation(fields: [connectionId], references: [id])
  createdAt    DateTime   @default(now())

  messages        Message[]
  workAssignments WorkAssignment[]
  safetyCases     SafetyCase[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?
}

// Negotiation phase: proposed <-> modification_requested -> accepted | rejected.
// Work/delivery phase (in_progress onward) is built out in a later phase; the
// enum values exist now so migrations don't need to reshape this column twice.
enum WorkAssignmentStatus {
  proposed
  modification_requested
  accepted
  in_progress
  submitted
  revision_requested
  delivery_accepted
  payment_pending
  completed
  disputed
  cancelled
  rejected
}

model WorkAssignment {
  id             String               @id @default(cuid())
  conversationId String
  conversation   Conversation         @relation(fields: [conversationId], references: [id])
  createdById    String
  title          String
  description    String
  budgetAmount   Decimal
  currency       String               @default("INR")
  dueDate        DateTime?
  status         WorkAssignmentStatus @default(proposed)
  // Set to the id of whichever participant first proposes cancelling; cleared
  // (assignment becomes "cancelled") once the other participant also calls
  // cancel. Not in the original data-model.md sketch — needed to actually
  // implement the documented mutual-confirm cancellation flow.
  cancelRequestedById String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  events              WorkAssignmentEvent[]
  deliverables        Deliverable[]
  paymentVerification PaymentVerification?
  reviews             Review[]
  safetyCases         SafetyCase[]
}

model WorkAssignmentEvent {
  id               String         @id @default(cuid())
  workAssignmentId String
  workAssignment   WorkAssignment @relation(fields: [workAssignmentId], references: [id])
  actorId          String
  action           String
  note             String?
  createdAt        DateTime       @default(now())
}

enum DeliverableType {
  demo
  preview
  watermarked_file
  drive_link
  github_link
  file
}

model Deliverable {
  id               String          @id @default(cuid())
  workAssignmentId String
  workAssignment   WorkAssignment  @relation(fields: [workAssignmentId], references: [id])
  type             DeliverableType
  url              String
  note             String?
  submittedAt      DateTime        @default(now())
}

enum PaymentVerificationStatus {
  awaiting_client
  awaiting_freelancer
  mismatch
  verified
  administratively_resolved
}

model PaymentVerification {
  id                  String                     @id @default(cuid())
  workAssignmentId    String                     @unique
  workAssignment      WorkAssignment             @relation(fields: [workAssignmentId], references: [id])
  clientUtr           String?
  clientClaimedAt     DateTime?
  freelancerUtr       String?
  freelancerClaimedAt DateTime?
  mismatchCount       Int                        @default(0)
  mismatchCountAtReopen Int                       @default(0)
  status              PaymentVerificationStatus  @default(awaiting_client)
  verifiedAt          DateTime?
  claims              PaymentClaim[]
}

// Append-only evidence of claims submitted after this feature's introduction.
// Current comparison fields may be cleared for another round; this history remains.
model PaymentClaim {
  id                    String              @id @default(cuid())
  paymentVerificationId String
  paymentVerification   PaymentVerification @relation(fields: [paymentVerificationId], references: [id])
  userId                String
  user                  User                @relation(fields: [userId], references: [id])
  party                 Role
  reference             String
  createdAt             DateTime            @default(now())

  @@index([paymentVerificationId, createdAt])
}

enum ReviewDirection {
  client_to_freelancer
  freelancer_to_client
}

model Review {
  id               String          @id @default(cuid())
  workAssignmentId String
  workAssignment   WorkAssignment  @relation(fields: [workAssignmentId], references: [id])
  authorId         String
  author           User            @relation(fields: [authorId], references: [id])
  targetId         String
  direction        ReviewDirection
  rating           Int
  comment          String?
  createdAt        DateTime        @default(now())

  @@unique([workAssignmentId, direction])
}

// userId null = broadcast to all users. Direct notifications keep isRead on
// the row; broadcast notifications use NotificationReadState for per-user read
// state so one recipient cannot mark the broadcast read for everyone.
model Notification {
  id         String                  @id @default(cuid())
  userId     String?
  type       String
  message    String
  isRead     Boolean                 @default(false)
  createdBy  String?
  createdAt  DateTime                @default(now())
  readStates NotificationReadState[]
}

model NotificationReadState {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@id([notificationId, userId])
  @@index([userId])
}

model UserBlock {
  id            String @id @default(cuid())
  blockerId     String
  blocker       User @relation("SafetyBlocker", fields: [blockerId], references: [id], onDelete: Restrict)
  blockedUserId String
  blockedUser   User @relation("SafetyBlocked", fields: [blockedUserId], references: [id], onDelete: Restrict)
  activeKey     String? @unique
  createdAt     DateTime @default(now())
  unblockedAt   DateTime?

  @@index([blockerId, blockedUserId, unblockedAt])
  @@index([blockedUserId, blockerId, unblockedAt])
}

enum SafetyCaseKind {
  user_report
  cancellation
  support
}

enum SafetyCaseStatus {
  open
  resolved
  dismissed
}

model SafetyCase {
  id             String @id @default(cuid())
  kind           SafetyCaseKind
  status         SafetyCaseStatus @default(open)
  reporterId     String
  reporter       User @relation("SafetyReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  targetUserId   String?
  targetUser     User? @relation("SafetyTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  assignmentId   String?
  assignment     WorkAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  category       String
  reason         String
  activeKey      String? @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reviewedById   String?
  reviewedAt     DateTime?
  decision       String?
  decisionReason String?
  events         SafetyCaseEvent[]

  @@index([kind, status, createdAt])
  @@index([reporterId, createdAt])
  @@index([assignmentId])
}

model SafetyCaseEvent {
  id        String @id @default(cuid())
  caseId    String
  case      SafetyCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actorId   String
  actor     User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  note      String?
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

// Ephemeral adapter transport payloads, not the persisted message/audit history.
model SocketIoAttachment {
  id        BigInt @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  payload   Bytes

  @@index([createdAt])
  @@map("socket_io_attachments")
}
