# Test toolchain only. Never used as an application runtime or pushed.
FROM mcr.microsoft.com/playwright:v1.58.2-noble
WORKDIR /checks
RUN npm install --no-save --package-lock=false playwright@1.58.2
COPY deploy/acceptance-browser.mjs ./acceptance-browser.mjs
COPY apps/frontend/test/staging-browser-acceptance.js ./staging-browser-acceptance.js
CMD ["node", "acceptance-browser.mjs"]
