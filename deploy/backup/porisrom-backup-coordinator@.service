[Unit]
Description=Porisrom backup coordinator (%i)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/porisrom/backup.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/porisrom/app/deploy/backup/porisrom-backup-coordinator.sh --class %i
UMask=0077
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/porisrom/backups /run/porisrom /var/lib/porisrom/backup-coordinator
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID
