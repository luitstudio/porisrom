# Install at /etc/porisrom/backup.env with root ownership and mode 0600.
# This file must contain no PostgreSQL password.  The age value is a public recipient.
PORISROM_BACKUP_ROOT=/opt/porisrom/backups
PORISROM_PROJECT_DIR=/opt/porisrom/app
PORISROM_PRODUCTION_COMPOSE_FILE=/opt/porisrom/app/deploy/compose.production.yml
# The same secret-manager managed file used by production Compose. The capture
# service passes it explicitly; an incidental checkout .env is never used.
PORISROM_PRODUCTION_ENV_FILE=/etc/porisrom/production.env
# Root-owned, root:1000 mode 0750. Compose mounts it read-only into verifier.
PORISROM_BACKUP_CANDIDATE_ROOT=/opt/porisrom/backups/candidates
PORISROM_VERIFIER_GID=1000
# Node 24 is installed here on production hosts; override only with an approved absolute path.
PORISROM_NODE_BIN=/usr/local/bin/node
# Conservative capacity gate: reserve plus estimated encrypted output and
# staging overhead. Never lower these values to make room by deleting recovery points.
PORISROM_BACKUP_MIN_FREE_KIB=<SUPPLY_APPROVED_MINIMUM_FREE_KIB>
PORISROM_BACKUP_SAFETY_RESERVE_KIB=<SUPPLY_APPROVED_SAFETY_RESERVE_KIB>
# Conservative allowance for age framing/output growth; defaults to 5.
PORISROM_BACKUP_ENCRYPTION_OVERHEAD_PCT=5
# Manifest/staging filesystem overhead; defaults to 65536 KiB.
PORISROM_BACKUP_TEMP_OVERHEAD_KIB=65536
PORISROM_BACKUP_AGE_RECIPIENT=age1<SUPPLY_PUBLIC_RECIPIENT_ONLY>
# Restricted HTTPS coordinator endpoint. These are root-readable mTLS client
# materials only; they are not PostgreSQL or application credentials.
PORISROM_BACKUP_COORDINATOR_URL=https://backup-coordinator.example.internal
PORISROM_BACKUP_COORDINATOR_CERT=/etc/porisrom/backup-coordinator.crt
PORISROM_BACKUP_COORDINATOR_KEY=/etc/porisrom/backup-coordinator.key
PORISROM_BACKUP_COORDINATOR_CA=/etc/porisrom/backup-coordinator-ca.crt
# Fixed mTLS principal ID expected in durable report-only result envelopes.
PORISROM_BACKUP_COORDINATOR_PRINCIPAL_ID=<SUPPLY_FIXED_COORDINATOR_PRINCIPAL_ID>
