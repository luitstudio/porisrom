# Store the real values in /etc/porisrom/production.env (root-owned, mode 600),
# never in this repository. The migration executor is a controlled database
# owner credential; DATABASE_URL is only the restricted backend runtime role.
POSTGRES_USER=controlled_migration_owner
POSTGRES_PASSWORD=replace-with-a-unique-migration-password
POSTGRES_DB=porisrom
MIGRATION_DATABASE_URL=postgresql://controlled_migration_owner:replace-with-a-unique-migration-password@postgres:5432/porisrom
DATABASE_URL=postgresql://porisrom_backend_runtime:replace-with-a-different-backend-runtime-password@postgres:5432/porisrom
ADMISSION_DATABASE_URL=postgresql://porisrom_admission_runtime:replace-with-a-different-admission-runtime-password@postgres:5432/porisrom
VERIFIER_DISPATCH_DATABASE_URL=postgresql://porisrom_dispatcher_runtime:replace-with-a-different-dispatcher-runtime-password@postgres:5432/porisrom
FINALIZER_DATABASE_URL=postgresql://porisrom_finalizer_runtime:replace-with-a-different-finalizer-runtime-password@postgres:5432/porisrom

# Backend-only backup coordinator mTLS proxy boundary. Use private proxy
# addresses only and a unique high-entropy token; neither belongs in any
# frontend, worker, admission, migration, or database environment.
BACKUP_COORDINATOR_TRUSTED_PROXY_IPS=replace-with-private-proxy-ip-or-cidr
BACKUP_COORDINATOR_MTLS_PROXY_TOKEN=replace-with-a-unique-high-entropy-token

# Supply the remaining required application URLs, OAuth values, storage
# credentials, and TLS secret-file paths through the approved secret manager.
