# Generate a unique random secret (at least 32 bytes) for each deployed environment.
# Never use this placeholder as the deployed secret.
AUTH_SECRET="replace-with-a-random-secret"
AUTH_TRUST_HOST="true"
# Server-side Next.js -> backend API. Required in production.
BACKEND_URL="http://localhost:4000"
# Browser -> backend API and Socket.IO. This value is public and required in production.
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"
