# Generate a unique random secret (at least 32 bytes) for each deployed environment.
# Never use this placeholder as the deployed secret.
AUTH_SECRET="replace-with-a-random-secret"
AUTH_TRUST_HOST="true"
# Local development only. Leave BACKEND_URL unset on Vercel for this UI preview.
# Set it to the real hosted API origin when backend integration starts.
BACKEND_URL="http://localhost:4000"
