# Local Docker PostgreSQL only. Production must use its private production connection string.
DATABASE_URL="postgresql://porisrom:porisrom@localhost:5433/porisrom"
BACKEND_PUBLIC_URL="http://localhost:4000"
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"
# Production: set HTTPS marketplace/admin origin(s), comma-separated if needed for CORS and Socket.IO.
# Local development: replace both values before using authentication.
# Production: each must be a unique random secret of at least 32 characters.
JWT_ACCESS_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-unique-random-secret-32-characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Google OAuth web client ID. This identifier is not a secret; the client secret
# stays in the frontend server environment used by Auth.js.
GOOGLE_CLIENT_ID=""
# Server-side only. Required for private identity-document uploads in environments that enable KYC.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Local development only; production rejects true. Private PDFs never use public uploads.
KYC_LOCAL_FALLBACK_ENABLED="true"
# New local PDFs: separate private root (default ./private-uploads, relative to backend cwd).
# PRIVATE_DOCUMENT_UPLOAD_DIR="./private-uploads"
# Legacy local: IDs only: preserve the former root if it was customized. No new writes here.
# KYC_DOCUMENT_UPLOAD_DIR="./uploads"
# Public images retain /uploads/profile-photos/*; other public files may use ./uploads/public.
# PROFILE_PHOTO_UPLOAD_DIR="./uploads"
